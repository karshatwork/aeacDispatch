{
  "name": "rk-fg-dispatch-system",
  "version": "1.0.0",
  "description": "RK FG Dispatch - Industrial Dispatch Management System with strict FIFO",

  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "build:exe": "node scripts/build-exe.js",
    "release": "node scripts/build-release.js",
    "license:gen": "node scripts/generate-license.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "remixicon": "^4.9.1",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "bytenode": "^1.7.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "keywords": [
    "dispatch",
    "fifo",
    "industrial",
    "manufacturing",
    "scada"
  ],
  "author": "Karsh",
  "license": "UNLICENSED"
}
