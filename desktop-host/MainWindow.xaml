<Window x:Class="DispatchHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RK FG Dispatch - Industrial Dispatch Management System"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0c121e"
        Icon="app.ico"
        Closing="Window_Closing">
    
    <Grid>
        <!-- Splash Loader Screen while Node starts -->
        <Border x:Name="splashLoader" Background="#0c121e" Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="RK FG DISPATCH // MANAGEMENT SYSTEM" 

                           Foreground="#f8fafc" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"
                           FontFamily="Consolas" />
                <TextBlock x:Name="txtStatus" Text="Initializing background engine..." 
                           Foreground="#94a3b8" FontSize="12" 
                           HorizontalAlignment="Center"
                           FontFamily="Consolas" />
            </StackPanel>
        </Border>

        <!-- Microsoft Edge WebView2 Control -->
        <wv2:WebView2 x:Name="webView" />
    </Grid>
</Window>
